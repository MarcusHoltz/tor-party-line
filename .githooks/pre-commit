#!/usr/bin/env bash
# Keep broken scripts, Tor key material, and secrets out of commits.
#
# tor-party-line.sh is the whole project: a syntax error committed here is a fully
# broken checkout for whoever pulls it. This hook checks the STAGED content,
# not the working tree, because it is possible to test one version and commit
# another. .gitignore can be bypassed with git add -f, so the hook enforces
# the same rules as a second line of defense.
#
# Enable (once per clone):  git config core.hooksPath .githooks
# Bypass in an emergency:   git commit --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1
fail=0

note() { printf '\033[0;31mpre-commit:\033[0m %s\n' "$1" >&2; }

staged_files="$(git diff --cached --name-only)"

# ── Dangerous files ───────────────────────────────────────────────
while IFS= read -r f; do
    [[ -z "$f" ]] && continue
    case "$f" in
        *hs_ed25519_secret_key|*hs_ed25519_public_key)
            note "$f is Tor hidden-service key material. Never commit it."
            note "  git rm --cached '$f'"
            fail=1
            ;;
        */hidden_service/hostname)
            note "$f is a Tor .onion address derived from the private key. Never commit it."
            note "  git rm --cached '$f'"
            fail=1
            ;;
        secrets/.gitkeep|data/.gitkeep|.env.example)
            ;;
        secrets/*)
            note "$f belongs in secrets/. Never commit it."
            note "  git rm --cached '$f'"
            fail=1
            ;;
        .env|.env.*|*.env)
            note "$f is an environment file. Never commit it."
            note "  git rm --cached '$f'"
            fail=1
            ;;
        data/*)
            note "$f is runtime data. Never commit it."
            note "  git rm --cached '$f'"
            fail=1
            ;;
    esac
done <<< "$staged_files"

if git ls-files --cached --error-unmatch secrets/shared_secret.txt >/dev/null 2>&1; then
    note "secrets/shared_secret.txt is in the index."
    note "  git rm --cached secrets/shared_secret.txt"
    fail=1
fi

# ── Script syntax ─────────────────────────────────────────────────
scripts_to_check=""
for s in tor-party-line.sh entrypoint.sh; do
    grep -qx "$s" <<< "$staged_files" && scripts_to_check="$scripts_to_check $s"
done

if [ -n "$scripts_to_check" ]; then
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "$tmpdir"' EXIT

    for script in $scripts_to_check; do
        if ! git show ":$script" > "$tmpdir/$script" 2>/dev/null; then
            note "could not read staged $script"
            fail=1
            continue
        fi
        if ! bash -n "$tmpdir/$script" 2>/dev/null; then
            note "staged $script is not valid bash:"
            bash -n "$tmpdir/$script" 2>&1 | sed 's/^/  /' >&2
            fail=1
        fi
    done
fi

# ── Transport seams (Tor-specific) ────────────────────────────────
if [ -f "${tmpdir:-}/tor-party-line.sh" ]; then
    if ! grep -q 'HiddenServiceDir' "$tmpdir/tor-party-line.sh"; then
        note "HiddenServiceDir is missing from the generated torrc in tor-party-line.sh"
        note "  Without it Tor starts but the hidden service never comes up."
        fail=1
    fi
    if ! grep -q 'HiddenServicePort' "$tmpdir/tor-party-line.sh"; then
        note "HiddenServicePort is missing from the generated torrc in tor-party-line.sh"
        note "  Without it the hidden service is created but unreachable."
        fail=1
    fi
fi

# ── Result ────────────────────────────────────────────────────────
[ $fail -eq 0 ] || note "commit blocked. Use --no-verify to override."
exit $fail
