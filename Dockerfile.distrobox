# Tor Party Line - Distrobox-ready image
#
# Built for use with distrobox, not docker compose. No DOCKER_MODE: the script
# runs in script mode. A wrapper at /usr/local/bin sets DATA_DIR to an XDG path
# on the host filesystem (distrobox bind-mounts $HOME), then execs the script.
#
# Build:  podman build -f Dockerfile.distrobox -t docker.io/marcusholtz/tor-party-line-box .
# Use:    distrobox assemble create --file distrobox.ini
#         distrobox enter partyline-tor
#         tor-party-line.sh

# -- Stage 1: compile pcm_rms ----------------------------------------
FROM debian:trixie-slim AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libc6-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN printf '%s\n' \
    '#include <stdio.h>' \
    '#include <math.h>' \
    '#include <stdint.h>' \
    'int main(void) {' \
    '    int16_t buf[4096];' \
    '    double sum = 0.0;' \
    '    long count = 0;' \
    '    size_t n;' \
    '    while ((n = fread(buf, sizeof(int16_t), 4096, stdin)) > 0) {' \
    '        for (size_t i = 0; i < n; i++) {' \
    '            double s = (double)buf[i];' \
    '            sum += s * s;' \
    '        }' \
    '        count += n;' \
    '    }' \
    '    if (count == 0) { printf("-91.0\n"); return 0; }' \
    '    double rms = sqrt(sum / count);' \
    '    double dbfs = 20.0 * log10(rms / 32768.0);' \
    '    printf("%.1f\n", dbfs);' \
    '    return 0;' \
    '}' > /tmp/pcm_rms.c \
    && gcc -O2 -o /tmp/pcm_rms /tmp/pcm_rms.c -lm

# Application menu entry. The icon is fetched at build time. A failed fetch
# prints a warning and falls back to a theme icon, it never fails the build.
RUN mkdir -p /out/usr/share/icons/hicolor/192x192/apps /out/usr/share/applications \
    && ICON_NAME=audio-headset \
    && if curl -fsSL --retry 3 --max-time 30 -o /tmp/icon.png \
        "https://raw.githubusercontent.com/MarcusHoltz/marcusholtz.github.io/refs/heads/main/assets/img/posts/tor-party-line--avatar.png" \
        && [ "$(head -c 8 /tmp/icon.png | od -An -tx1 | tr -d ' \n')" = "89504e470d0a1a0a" ]; then \
            install -Dm644 /tmp/icon.png /out/usr/share/icons/hicolor/192x192/apps/tor-party-line.png \
            && ICON_NAME=tor-party-line; \
        else \
            printf '%s\n' \
                '************************************************************' \
                'WARNING: could not fetch a valid PNG icon from:' \
                '  https://raw.githubusercontent.com/MarcusHoltz/marcusholtz.github.io/refs/heads/main/assets/img/posts/tor-party-line--avatar.png' \
                'Building WITHOUT the custom icon. The menu entry will use' \
                'the generic theme icon "audio-headset".' \
                '************************************************************' >&2; \
        fi \
    && printf '[Desktop Entry]\nType=Application\nName=Tor Party Line\nComment=Encrypted push-to-talk voice and group party line over Tor hidden services\nExec=tor-party-line.sh\nIcon=%s\nTerminal=true\nCategories=Network;Chat;\n' "$ICON_NAME" \
        > /out/usr/share/applications/tor-party-line.desktop

# -- Stage 2: runtime ------------------------------------------------
FROM debian:trixie-slim

RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends \
        tor \
        opus-tools \
        socat \
        openssl \
        alsa-utils \
        pulseaudio-utils \
        qrencode \
        ncurses-bin \
        libsodium23 \
        python3 \
        libopus0 \
        procps \
        sudo \
        passwd \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /tmp/pcm_rms /usr/local/bin/pcm_rms
COPY --from=builder /out/ /

RUN mkdir -p /usr/local/lib/partyline
COPY tor-party-line.sh /usr/local/lib/partyline/tor-party-line.sh
RUN chmod +x /usr/local/lib/partyline/tor-party-line.sh

RUN printf '#!/bin/bash\nexport DATA_DIR="${DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tor-party-line}"\nexec /usr/local/lib/partyline/tor-party-line.sh "$@"\n' \
    > /usr/local/bin/tor-party-line.sh \
    && chmod +x /usr/local/bin/tor-party-line.sh
